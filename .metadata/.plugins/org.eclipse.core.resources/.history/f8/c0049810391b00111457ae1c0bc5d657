
/* Includes */
#include "cmd_processing.h"
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* Defines */
#define PULSE_LEN_MIN 10
#define PULSE_LEN_MAX 100

/* Static functions declaration */
static void process_cmd(char *);
static void process_cmd_turn(char *);
static void process_cmd_read(char *);
static void process_cmd_pulse(char *);
static void process_cmd_ncmd(char *);


/* Global functions */
void uart_byte_available(uint8_t c)
{
    static uint16_t cnt;
    static char data[CMD_BUFFER_LEN];

    if (cnt < CMD_BUFFER_LEN && c >= 32 && c <= 126)
    {
    	data[cnt++] = c;
    }

    if ((c == '\n' || c == '\r') && cnt > 0)
    {
        data[cnt] = '\0';
        process_cmd(data);
        cnt = 0;
    }
}

/* Static functions */
static void process_cmd(char * cmd)
{
	char *token;
	token = strtok(cmd, " ");

	/* Communication test */
	if (strcasecmp(token, "HELLO") == 0)
	{
	    printf("Communication OK\n");
	}
	/* Set default position */
	else if (strcasecmp(token, "HOME") == 0)
	{
		printf("Home\n");
	}
	/* Perform 1 step */
	else if (strcasecmp(token, "TURN") == 0)
	{
		process_cmd_turn(token);
	}
	/* Perform 1 pulse */
	else if (strcasecmp(token, "PULSE") == 0)
	{
		process_cmd_pulse(token);
	}
	/* Once read data from sensor */
	else if (strcasecmp(token, "READ") == 0)
	{
		process_cmd_read(token);
	}
	/* Once read data from sensor */
	else if (strcasecmp(token, "CMD") == 0)
	{
		process_cmd_ncmd(token);
	}
}

/* TURN cmd callback */
static void process_cmd_turn(char * token)
{
	token = strtok(NULL, " ");
    if (strcasecmp(token, "RIGHT") == 0)
    {
    	printf("Right\n");
    }
    else if (strcasecmp(token, "LEFT") == 0)
    {
    	printf("Left\n");
    }
}

/* READ cmd callback */
static void process_cmd_read(char * token)
{
    token = strtok(NULL, " ");

    if (strcasecmp(token, "MAG") == 0)
    {
    	printf("M: data\n");
    }
    else if (strcasecmp(token, "GYR") == 0)
    {
    	printf("G: data\n");
    }
    else if (strcasecmp(token, "ACC") == 0)
    {
    	printf("A: data\n");
    }
    else if (strcasecmp(token, "ALL") == 0)
    {
    	printf("M: data\n");
    	printf("G: data\n");
    	printf("A: data\n");
    }
    else
    {
    	printf("Unknown\n");
    }
}

/* PULSE cmd callback */
static void process_cmd_pulse(char * token)
{
	uint8_t pulse_len;
	token = strtok(NULL, " ");

	if (strcasecmp(token, "RIGHT") == 0)
	{
	   	printf("Right\n");
	}
	else if (strcasecmp(token, "LEFT") == 0)
	{
	   	printf("Left\n");
	}

	token = strtok(NULL, " ");

	pulse_len = atoi(token);

	if ((pulse_len >= PULSE_LEN_MIN) && (pulse_len <= PULSE_LEN_MAX))
	{
	   	printf("%s ms\n",token);
	}
	else
	{
	  	printf("Invalid time\n");
	}
}

/* Reserve commands */
static void process_cmd_ncmd(char *)
{
	uint8_t ncmd;

	token = strtok(NULL, " ");
	ncmd = atoi(token);

	switch (ncmd)
	{
		case 0:
			printf("Reserve 0\n");
			break;
		case 1:
			printf("Reserve 1\n");
			break;
		case 2:
			printf("Reserve 2\n");
			break;
		case 3:
			printf("Reserve 3\n");
			break;
		default:
			printf("Reserve 3\n");
			break;
	}
}


